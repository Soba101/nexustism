# OpenAI API Key (optional, for future features)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Database Configuration (External Access from host machine)
DB_HOST=localhost
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.nexustism-tenant
DB_PASSWORD=your_database_password_here

# Supabase Internal (Docker) Configuration (used when API runs inside Docker)
DB_HOST_INTERNAL=supabase-db
DB_PORT_INTERNAL=5432
DB_USER_INTERNAL=supabase_admin

# Supabase Studio Access
SUPABASE_STUDIO_URL=http://localhost:3000
SUPABASE_STUDIO_USER=admin@example.com
SUPABASE_STUDIO_PASSWORD=your_studio_password_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001

# Model Paths (relative to project root)
V4_MODEL_PATH=models/real_servicenow_finetuned_mpnet_lora/real_servicenow_v2_20260104_2321/
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# Disable parallelism for tokenizers to avoid warnings
TOKENIZERS_PARALLELISM=false

# ServiceNow Credentials (for scheduled sync)
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com/
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password

# ServiceNow Import Settings
SN_INSTANCE=https://your-instance.service-now.com
SN_USER=your_username
SN_PASS=your_password
IMPORT_TABLE=dummy_data
TARGET_TABLE=incident
TRANSFORM_MAP_SYS_ID=your_transform_map_id
CSV_PATH=data/dummy_data.csv
IMPORT_SET_ID=your_import_set_id

# Hugging Face Token (for model downloads)
HUGGINGFACE_TOKEN=your_huggingface_token_here
