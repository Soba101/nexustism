   "source": [
    "import copy\n",
    "\n",
    "# --- Training Execution (V5.2: curriculum + best in-memory state tracking) ---\n",
    "use_pre_generated_pairs = CONFIG.get('use_pre_generated_pairs', False)\n",
    "\n",
    "if True:\n",
    "    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M\")\n",
    "    save_path = Path(CONFIG['output_dir']) / f\"real_servicenow_v2_{timestamp}\"\n",
    "    save_path.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    log(f\"\\n🚀 Starting Training (V5.2)...\")\n",
    "    log(f\"   Output: {save_path}\")\n",
    "    log(f\"   Epochs: {CONFIG['epochs']}\")\n",
    "    log(f\"   Device: {DEVICE}\")\n",
    "\n",
    "    total_steps = len(train_dataloader) * CONFIG['epochs']\n",
    "    warmup_steps = int(total_steps * CONFIG['warmup_ratio'])\n",
    "    eval_steps = max(100, len(train_dataloader) // 2)\n",
    "    use_amp = DEVICE != 'cuda'\n",
    "\n",
    "    # V5.2: Track best model state_dict across phases.\n",
    "    # model.fit(save_best_model=True) saves to disk but has PEFT namespace mismatch\n",
    "    # on reload. Instead, we snapshot the state_dict (CPU tensors) after each phase\n",
    "    # and restore before the merge — so merge_and_unload fuses the BEST LoRA weights,\n",
    "    # not the final-phase weights (which may have degraded).\n",
    "    _best_eval_spearman: float = -1.0\n",
    "    _best_sd: dict | None     = None   # CPU state_dict of best phase\n",
    "\n",
    "    def _save_best_sd(m, spearman: float, label: str) -> float:\n",
    "        \"\"\"If spearman > current best, save a CPU clone of the auto_model state_dict.\"\"\"\n",
    "        global _best_eval_spearman, _best_sd\n",
    "        if spearman > _best_eval_spearman:\n",
    "            _best_eval_spearman = spearman\n",
    "            _best_sd = {k: v.detach().cpu().clone()\n",
    "                        for k, v in m[0].auto_model.state_dict().items()}\n",
    "            log(f\"[OK] {label}: new best Spearman={_best_eval_spearman:.4f} \"\n",
    "                f\"— state_dict saved ({len(_best_sd)} tensors)\")\n",
    "        return _best_eval_spearman\n",
    "\n",
    "    try:\n",
    "        if CONFIG['use_curriculum']:\n",
    "            log(\"\\n📚 CURRICULUM LEARNING ENABLED\")\n",
    "\n",
    "            phase_configs = CONFIG.get('curriculum_phases', [])\n",
    "            if use_pre_generated_pairs and CURRICULUM_PHASES:\n",
    "                phase_epochs = CONFIG.get('epochs_per_phase', 2)\n",
    "                phase_configs = [\n",
    "                    {'epochs': phase_epochs, 'phase_key': 'phase1'},\n",
    "                    {'epochs': phase_epochs, 'phase_key': 'phase2'},\n",
    "                    {'epochs': phase_epochs, 'phase_key': 'phase3'},\n",
    "                ]\n",
    "\n",
    "            for phase_idx, phase in enumerate(phase_configs):\n",
    "                log(f\"\\n{'='*60}\")\n",
    "                log(f\"📚 Phase {phase_idx + 1}: {phase['epochs']} epochs\")\n",
    "                hard_neg_ratio = phase.get('hard_neg_ratio')\n",
    "                neg_threshold = phase.get('neg_threshold')\n",
    "                if hard_neg_ratio is not None:\n",
    "                    log(f\"   Hard neg ratio: {hard_neg_ratio*100:.0f}%\")\n",
    "                if neg_threshold is not None:\n",
    "                    log(f\"   Neg threshold: {neg_threshold}\")\n",
    "                log(f\"{'='*60}\")\n",
    "\n",
    "                phase_train_examples = generate_training_pairs(\n",
    "                    train_df,\n",
    "                    len(train_examples),\n",
    "                    CONFIG,\n",
    "                    desc=f\"Phase {phase_idx+1}\",\n",
    "                    phase_config=phase,\n",
    "                    tfidf_calc=tfidf_train\n",
    "                )\n",
    "\n",
    "                phase_batch_size = 16\n",
    "                phase_dataloader = DataLoader(\n",
    "                    phase_train_examples,\n",
    "                    shuffle=True,\n",
    "                    batch_size=phase_batch_size,\n",
    "                    num_workers=0,\n",
    "                    pin_memory=(DEVICE in ['cuda', 'mps'])\n",
    "                )\n",
    "\n",
    "                phase_warmup = int(\n",
    "                    len(phase_dataloader)\n",
    "                    * phase.get('epochs', CONFIG.get('epochs_per_phase', 2))\n",
    "                    * CONFIG['warmup_ratio']\n",
    "                )\n",
    "\n",
    "                try:\n",
    "                    if DEVICE == 'cuda':\n",
    "                        torch.cuda.empty_cache()\n",
    "                except Exception:\n",
    "                    pass\n",
    "\n",
    "                model.fit(\n",
    "                    train_objectives=[(phase_dataloader, train_loss)],\n",
    "                    evaluator=evaluator,\n",
    "                    epochs=phase.get('epochs', CONFIG.get('epochs_per_phase', 2)),\n",
    "                    warmup_steps=phase_warmup,\n",
    "                    optimizer_params={'lr': CONFIG['lr']},\n",
    "                    output_path=str(save_path),\n",
    "                    evaluation_steps=eval_steps,\n",
    "                    save_best_model=True,\n",
    "                    show_progress_bar=True,\n",
    "                    use_amp=use_amp,\n",
    "                )\n",
    "\n",
    "                log(f\"[OK] Phase {phase_idx + 1} complete!\")\n",
    "\n",
    "                # V5.2: snapshot state if this phase produced the best eval score\n",
    "                _phase_sp = evaluator(model, output_path=str(save_path),\n",
    "                                      epoch=phase_idx + 1, steps=-1)\n",
    "                _save_best_sd(model, _phase_sp, f\"Phase {phase_idx+1} snapshot\")\n",
    "\n",
    "        else:\n",
    "            try:\n",
    "                if DEVICE == 'cuda':\n",
    "                    torch.cuda.empty_cache()\n",
    "            except Exception:\n",
    "                pass\n",
    "\n",
    "            model.fit(\n",
    "                train_objectives=[(train_dataloader, train_loss)],\n",
    "                evaluator=evaluator,\n",
    "                epochs=CONFIG['epochs'],\n",
    "                warmup_steps=warmup_steps,\n",
    "                optimizer_params={'lr': CONFIG['lr']},\n",
    "                output_path=str(save_path),\n",
    "                evaluation_steps=eval_steps,\n",
    "                save_best_model=True,\n",
    "                show_progress_bar=True,\n",
    "                use_amp=use_amp,\n",
    "            )\n",
    "            # single-phase: snapshot after training completes\n",
    "            _phase_sp = evaluator(model, output_path=str(save_path), epoch=1, steps=-1)\n",
    "            _save_best_sd(model, _phase_sp, \"Single-phase snapshot\")\n",
    "\n",
    "        log(\"\\n[OK] Training complete!\")\n",
    "\n",
    "    except RuntimeError as e:\n",
    "        err_msg = str(e).lower()\n",
    "        if (\"out of memory\" in err_msg) or (\"no kernel image\" in err_msg) or (\"not compatible\" in err_msg):\n",
    "            log(f\"[ERROR] Runtime Error: {e}\")\n",
    "            log(\"💡 Falling back to CPU/MPS...\")\n",
    "            try:\n",
    "                del model\n",
    "            except Exception:\n",
    "                pass\n",
    "            try:\n",
    "                if torch.cuda.is_available():\n",
    "                    torch.cuda.empty_cache()\n",
    "            except Exception:\n",
    "                pass\n",
    "            gc.collect()\n",
    "\n",
    "            if hasattr(torch.backends, 'mps') and torch.backends.mps.is_available():\n",
    "                DEVICE = 'mps'\n",
    "                log(\"🍎 Switching to MPS\")\n",
    "            else:\n",
    "                DEVICE = 'cpu'\n",
    "                log(\"[BUILD] Switching to CPU\")\n",
    "\n",
    "            model = init_model_with_lora(CONFIG, DEVICE)\n",
    "            train_loss, loss_name = build_train_loss(model, CONFIG)\n",
    "            log(f\"[Fallback] Using {loss_name}\")\n",
    "\n",
    "            safe_batch = 8 if DEVICE != 'cuda' else 16\n",
    "            fallback_use_amp = DEVICE != 'cuda'\n",
    "            if CONFIG['use_curriculum']:\n",
    "                phase_configs = CONFIG.get('curriculum_phases', [])\n",
    "                if use_pre_generated_pairs and CURRICULUM_PHASES:\n",
    "                    phase_epochs = CONFIG.get('epochs_per_phase', 2)\n",
    "                    phase_configs = [\n",
    "                        {'epochs': phase_epochs, 'phase_key': 'phase1'},\n",
    "                        {'epochs': phase_epochs, 'phase_key': 'phase2'},\n",
    "                        {'epochs': phase_epochs, 'phase_key': 'phase3'},\n",
    "                    ]\n",
    "\n",
    "                for phase_idx, phase in enumerate(phase_configs):\n",
    "                    log(f\"\\n[Fallback] Phase {phase_idx + 1}\")\n",
    "                    phase_train_examples = generate_training_pairs(\n",
    "                        train_df, len(train_examples), CONFIG,\n",
    "                        desc=f\"Phase {phase_idx+1}\", phase_config=phase,\n",
    "                        tfidf_calc=tfidf_train\n",
    "                    )\n",
    "                    phase_dataloader = DataLoader(\n",
    "                        phase_train_examples, shuffle=True, batch_size=safe_batch,\n",
    "                        num_workers=0, pin_memory=(DEVICE in ['cuda', 'mps'])\n",
    "                    )\n",
    "                    phase_warmup = int(\n",
    "                        len(phase_dataloader)\n",
    "                        * phase.get('epochs', CONFIG.get('epochs_per_phase', 2))\n",
    "                        * CONFIG['warmup_ratio']\n",
    "                    )\n",
    "                    model.fit(\n",
    "                        train_objectives=[(phase_dataloader, train_loss)],\n",
    "                        evaluator=evaluator,\n",
    "                        epochs=phase.get('epochs', CONFIG.get('epochs_per_phase', 2)),\n",
    "                        warmup_steps=phase_warmup,\n",
    "                        optimizer_params={'lr': CONFIG['lr']},\n",
    "                        output_path=str(save_path),\n",
    "                        evaluation_steps=eval_steps,\n",
    "                        save_best_model=True,\n",
    "                        show_progress_bar=True,\n",
    "                        use_amp=fallback_use_amp,\n",
    "                    )\n",
    "                    log(f\"[OK] Fallback Phase {phase_idx + 1} complete!\")\n",
    "                    _phase_sp = evaluator(model, output_path=str(save_path),\n",
    "                                          epoch=phase_idx + 1, steps=-1)\n",
    "                    _save_best_sd(model, _phase_sp, f\"Fallback Phase {phase_idx+1}\")\n",
    "            else:\n",
    "                model.fit(\n",
    "                    train_objectives=[(train_dataloader, train_loss)],\n",
    "                    evaluator=evaluator,\n",
    "                    epochs=CONFIG['epochs'],\n",
    "                    warmup_steps=warmup_steps,\n",
    "                    optimizer_params={'lr': CONFIG['lr']},\n",
    "                    output_path=str(save_path),\n",
    "                    evaluation_steps=eval_steps,\n",
    "                    save_best_model=True,\n",
    "                    show_progress_bar=True,\n",
    "                    use_amp=fallback_use_amp,\n",
    "                )\n",
    "                _phase_sp = evaluator(model, output_path=str(save_path), epoch=1, steps=-1)\n",
    "                _save_best_sd(model, _phase_sp, \"Fallback single-phase\")\n",
    "\n",
    "            log(\"\\n[OK] Training complete on fallback device!\")\n",
    "        else:\n",
    "            raise\n",
    "\n",
    "    # ── V5.2: Restore best phase state, then merge LoRA ─────────────────────\n",
    "    # 1. Restore state_dict from the best phase (not necessarily the last phase).\n",
    "    #    This prevents catastrophic forgetting from later phases degrading the best.\n",
    "    # 2. merge_and_unload() fuses the BEST LoRA weights into MPNet base weights.\n",
    "    # 3. Save merged model — no PEFT namespace, loadable as a plain SentenceTransformer.\n",
    "    # ─────────────────────────────────────────────────────────────────────────\n",
    "    log(f\"\\n[STATS] Best phase Spearman across all phases: {_best_eval_spearman:.4f}\")\n",
    "\n",
    "    if _best_sd is not None:\n",
    "        log(\"[INFO] Restoring best phase state_dict before merge...\")\n",
    "        try:\n",
    "            model[0].auto_model.load_state_dict(_best_sd, strict=False)\n",
    "            log(f\"[OK] Restored — {len(_best_sd)} tensors loaded\")\n",
    "        except Exception as _restore_err:\n",
    "            log(f\"[WARN] state_dict restore failed: {_restore_err}  — using final state\")\n",
    "        del _best_sd\n",
    "        gc.collect()\n",
    "    else:\n",
    "        log(\"[INFO] No phase snapshots available — using final model state\")\n",
    "\n",
    "    log(\"[STATS] Merging LoRA adapters into base weights (in-memory)...\")\n",
    "    if CONFIG.get('use_lora', False):\n",
    "        try:\n",
    "            model[0].auto_model = model[0].auto_model.merge_and_unload()\n",
    "            log(\"[OK] LoRA adapters merged successfully\")\n",
    "        except Exception as _merge_err:\n",
    "            log(f\"[WARN] merge_and_unload failed: {_merge_err}\")\n",
    "            log(\"[WARN] Using un-merged model (LoRA weights may not apply correctly)\")\n",
    "    else:\n",
    "        log(\"[INFO] No LoRA — using model as-is\")\n",
    "\n",
    "    best_model = model  # LoRA fused into MPNet, best phase state restored\n",
    "\n",
    "    merged_save_path = str(save_path) + '_merged'\n",
    "    try:\n",
    "        model.save(merged_save_path)\n",
    "        log(f\"[OK] Merged model saved → {merged_save_path}\")\n",
    "    except Exception as _save_err:\n",
    "        log(f\"[WARN] Could not save merged model: {_save_err}\")\n"
   ]
  },
