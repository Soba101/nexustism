    "import random\n",
    "import numpy as np\n",
    "import torch\n",
    "import logging\n",
    "\n",
    "# Simple logging\n",
    "def log(msg, level=logging.INFO):\n",
    "    print(msg)\n",
    "\n",
    "# --- CONFIGURATION (V5.3 - Nomic Base, Group-Based Pair Training) ---\n",
    "# V5.3 changes vs V5.2:\n",
    "#   Base model swapped: all-mpnet-base-v2 → nomic-ai/nomic-embed-text-v1.5\n",
    "#   Motivation: Nomic achieved Spearman=0.4476 zero-shot on the grounded\n",
    "#               semantic benchmark vs 0.2920 for MPNet — highest ceiling.\n",
    "#   LoRA target: changed to 'Wqkv' (Nomic's fused QKV projection);\n",
    "#                'query'/'key'/'value' kept as fallback.\n",
    "#   New train_pairs_path so pairs are regenerated fresh (new model tokenizer).\n",
    "#   Everything else (curriculum, CosineSimilarityLoss, best-state tracking) unchanged.\n",
    "CONFIG = {\n",
    "    # Model\n",
    "    'model_name': 'nomic-ai/nomic-embed-text-v1.5',\n",
    "    'trust_remote_code': True,         # Required for Nomic custom bert architecture\n",
    "    'output_dir': 'models/real_servicenow_finetuned_nomic_lora',\n",
    "\n",
    "    # Data - V5.3: new path forces pair regeneration (new tokenizer changes text encoding)\n",
    "    'use_pre_generated_pairs': True,   # Generate once, reuse across phases\n",
    "    'train_pairs_path': 'data_new/group_based_training_pairs_v5_3_nomic.json',\n",
    "    'eval_pairs_path':  'data_new/semantic_test_pairs_v3.json',\n",
    "    'source_data': 'data_new\\\\SNow_incident_ticket_data.csv',\n",
    "\n",
    "    # LoRA/PEFT Configuration\n",
    "    'use_lora': True,\n",
    "    'lora_r': 16,\n",
    "    'lora_alpha': 32,\n",
    "    'lora_dropout': 0.1,\n",
    "    'lora_target_modules': ['Wqkv', 'query', 'key', 'value'],  # Wqkv = Nomic fused QKV; fallbacks for other archs\n",
    "\n",
    "    # Loss Function — pure CosineSimilarityLoss (V5.1 fix, keep in V5.3)\n",
    "    'use_multi_loss': False,\n",
    "    'loss_type': 'cosine',\n",
    "    'mnrl_weight': 0.7,\n",
    "    'cosine_weight': 0.3,\n",
    "    'mnrl_scale': 15.0,\n",
    "\n",
    "    # Training hyperparameters\n",
    "    'epochs': 12,\n",
    "    'batch_size': 32,\n",
    "    'lr': 2e-5,\n",
    "    'max_seq_length': 256,\n",
    "    'warmup_ratio': 0.1,\n",
    "\n",
    "    # Curriculum Learning\n",
    "    'use_curriculum': True,\n",
    "    'epochs_per_phase': 4,\n",
    "\n",
    "    # Semantic hard negative mining (disabled)\n",
    "    'use_semantic_hard_negatives': False,\n",
    "    'semantic_hard_negative_fraction': 0.2,\n",
    "    'semantic_min_similarity': None,\n",
    "    'semantic_model_name': 'sentence-transformers/all-mpnet-base-v2',\n",
    "    'semantic_batch_size': 64,\n",
    "    'semantic_device': None,\n",
    "\n",
    "    # Data splits\n",
    "    'eval_split': 0.15,\n",
    "    'holdout_split': 0.10,\n",
    "    'min_text_length': 25,\n",
    "\n",
    "    # Pair generation (LEGACY)\n",
    "    'num_pairs': 50000,\n",
    "    'pos_ratio': 0.30,\n",
    "\n",
    "    # CV threshold selection\n",
    "    'threshold_cv_folds': 5,\n",
    "\n",
    "    # Reproducibility\n",
    "    'seed': 42,\n",
    "\n",
    "    # MNRL Positive-Only Mode\n",
    "    'use_mnrl_positive_only': False,\n",
    "    'train_pairs_path_mnrl': 'data_new/group_based_positive_only_pairs_mnrl_v1.json',\n",
    "}\n",
    "\n",
    "# Set seeds\n",
    "random.seed(CONFIG['seed'])\n",
    "np.random.seed(CONFIG['seed'])\n",
    "torch.manual_seed(CONFIG['seed'])\n",
    "\n",
    "log(\"=\"*70)\n",
    "log(\"CONFIGURATION (V5.3 - Nomic Base, Group-Based Training)\")\n",
    "log(\"=\"*70)\n",
    "log(f\"Model: {CONFIG['model_name']}  (trust_remote_code={CONFIG['trust_remote_code']})\")\n",
    "log(f\"Output: {CONFIG['output_dir']}\")\n",
    "log(f\"\\nData (V5.3 — Group-Based + Category Labels, gate=0.30):\")\n",
    "log(f\"  Train pairs: {CONFIG['train_pairs_path']}\")\n",
    "log(f\"  Eval pairs:  {CONFIG['eval_pairs_path']}\")\n",
    "log(f\"\\nLoss (pure CosineSimilarityLoss):\")\n",
    "log(f\"  use_multi_loss: {CONFIG['use_multi_loss']} (MNRL disabled)\")\n",
    "log(f\"  loss_type: {CONFIG['loss_type']}\")\n",
    "log(f\"\\nTraining:\")\n",
    "log(f\"  Total epochs: {CONFIG['epochs']}\")\n",
    "log(f\"  Learning rate: {CONFIG['lr']}\")\n",
    "log(f\"  Batch size: {CONFIG['batch_size']}\")\n",
    "log(f\"\\nCurriculum (hard-neg ratio: 20% → 35% → 40%):\")\n",
    "log(f\"  Epochs per phase: {CONFIG['epochs_per_phase']}\")\n",
    "log(\"=\"*70)\n"
   ]
