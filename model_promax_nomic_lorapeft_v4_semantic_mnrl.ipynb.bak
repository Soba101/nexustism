     "text": [
      "\n",
      "[STATS] Borderline Set Results:\n",
      "   Spearman:       0.8635\n",
      "   Pearson:        0.9685\n",
      "   ROC-AUC:        0.9985\n",
      "   PR-AUC:         0.9986\n",
      "   Best Threshold: 0.663\n",
      "   F1 @ best:      0.9820\n",
