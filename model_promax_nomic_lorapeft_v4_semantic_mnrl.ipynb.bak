   "source": [
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# ERROR ANALYSIS (V5: holdout / borderline optional — None in curriculum path)\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "def analyze_errors(results, name=\"\", top_k=10):\n",
    "    \"\"\"\n",
    "    Analyze systematic failure patterns in model predictions.\n",
    "\n",
    "    Returns insights about:\n",
    "    - Worst false positives (high score, label=0)\n",
    "    - Worst false negatives (low score, label=1)\n",
    "    - Text length patterns\n",
    "    \"\"\"\n",
    "    labels    = results['labels']\n",
    "    scores    = results['scores']\n",
    "    texts1    = results['texts1']\n",
    "    texts2    = results['texts2']\n",
    "    threshold = results['best_threshold']\n",
    "\n",
    "    preds = (scores >= threshold).astype(int)\n",
    "\n",
    "    fp_mask    = (preds == 1) & (labels == 0)\n",
    "    fp_indices = np.where(fp_mask)[0]\n",
    "    fp_scores  = scores[fp_mask]\n",
    "\n",
    "    fn_mask    = (preds == 0) & (labels == 1)\n",
    "    fn_indices = np.where(fn_mask)[0]\n",
    "    fn_scores  = scores[fn_mask]\n",
    "\n",
    "    log(f\"\\n{'='*60}\")\n",
    "    log(f\"ERROR ANALYSIS: {name}\")\n",
    "    log(f\"{'='*60}\")\n",
    "    log(f\"Total pairs:     {len(labels):,}\")\n",
    "    log(f\"False Positives: {len(fp_indices):,} ({len(fp_indices)/len(labels)*100:.2f}%)\")\n",
    "    log(f\"False Negatives: {len(fn_indices):,} ({len(fn_indices)/len(labels)*100:.2f}%)\")\n",
    "\n",
    "    if len(fp_indices) > 0:\n",
    "        log(f\"\\nWORST FALSE POSITIVES (Top {min(top_k, len(fp_indices))}):\")\n",
    "        for rank, idx in enumerate(np.argsort(fp_scores)[::-1][:top_k]):\n",
    "            orig = fp_indices[idx]\n",
    "            log(f\"\\n   [{rank+1}] Score: {scores[orig]:.4f}\")\n",
    "            log(f\"       Text 1: {texts1[orig][:100]}...\")\n",
    "            log(f\"       Text 2: {texts2[orig][:100]}...\")\n",
    "\n",
    "    if len(fn_indices) > 0:\n",
    "        log(f\"\\nWORST FALSE NEGATIVES (Top {min(top_k, len(fn_indices))}):\")\n",
    "        for rank, idx in enumerate(np.argsort(fn_scores)[:top_k]):\n",
    "            orig = fn_indices[idx]\n",
    "            log(f\"\\n   [{rank+1}] Score: {scores[orig]:.4f}\")\n",
    "            log(f\"       Text 1: {texts1[orig][:100]}...\")\n",
    "            log(f\"       Text 2: {texts2[orig][:100]}...\")\n",
    "\n",
    "    all_lengths = [len(t) for t in texts1 + texts2]\n",
    "    fp_lengths  = [len(texts1[i]) + len(texts2[i]) for i in fp_indices] if len(fp_indices) > 0 else [0]\n",
    "    fn_lengths  = [len(texts1[i]) + len(texts2[i]) for i in fn_indices] if len(fn_indices) > 0 else [0]\n",
    "\n",
    "    log(f\"\\nTEXT LENGTH:\")\n",
    "    log(f\"   Overall avg: {np.mean(all_lengths):.0f} chars\")\n",
    "    log(f\"   FP avg:      {np.mean(fp_lengths):.0f} chars\")\n",
    "    log(f\"   FN avg:      {np.mean(fn_lengths):.0f} chars\")\n",
    "\n",
    "    if len(fp_scores) > 0:\n",
    "        log(f\"   FP scores: [{fp_scores.min():.4f}, {fp_scores.max():.4f}] mean={fp_scores.mean():.4f}\")\n",
    "    if len(fn_scores) > 0:\n",
    "        log(f\"   FN scores: [{fn_scores.min():.4f}, {fn_scores.max():.4f}] mean={fn_scores.mean():.4f}\")\n",
    "\n",
    "    return {\n",
    "        'fp_count': len(fp_indices), 'fn_count': len(fn_indices),\n",
    "        'fp_scores': fp_scores,      'fn_scores': fn_scores,\n",
    "        'fp_avg_length': np.mean(fp_lengths),\n",
    "        'fn_avg_length': np.mean(fn_lengths),\n",
    "    }\n",
    "\n",
    "\n",
    "# Run error analysis — holdout / borderline are optional (None in V5 curriculum path)\n",
    "eval_errors      = analyze_errors(eval_results, \"Eval Set (v3 group-based)\", top_k=5)\n",
    "holdout_errors   = (analyze_errors(holdout_results,   \"Holdout Set\",    top_k=5)\n",
    "                    if holdout_results   is not None else None)\n",
    "borderline_errors = (analyze_errors(borderline_results, \"Borderline Set\", top_k=5)\n",
    "                     if borderline_results is not None else None)\n",
    "\n",
    "# Summary table\n",
    "log(f\"\\n{'='*60}\")\n",
    "log(f\"ERROR SUMMARY COMPARISON\")\n",
    "log(f\"{'='*60}\")\n",
    "log(f\"{'Set':<18} {'FP':<10} {'FN':<10} {'FP%':<10} {'FN%':<10}\")\n",
    "log(f\"{'-'*58}\")\n",
    "for _name, _errors, _results in [\n",
    "    (\"Eval (v3-group)\", eval_errors,      eval_results),\n",
    "    (\"Holdout\",         holdout_errors,   holdout_results),\n",
    "    (\"Borderline\",      borderline_errors, borderline_results),\n",
    "]:\n",
    "    if _results is None or _errors is None:\n",
    "        log(f\"[SKIP] {_name} — not available\")\n",
    "        continue\n",
    "    _tot = len(_results['labels'])\n",
    "    log(f\"{_name:<18} {_errors['fp_count']:<10} {_errors['fn_count']:<10} \"\n",
    "        f\"{_errors['fp_count']/_tot*100:<10.2f} {_errors['fn_count']/_tot*100:<10.2f}\")\n"
   ]
  },
