   "source": [
    "log(\"=\"*60)\n",
    "log(\"🔬 ADVERSARIAL DIAGNOSTIC: Group-Boundary Confusion Test (V5.2)\")\n",
    "log(\"=\"*60)\n",
    "log(\"\"\"\n",
    "Test design:\n",
    "  Hard positives : same Assignment group, TF-IDF < 0.15\n",
    "    → No shared keywords — model must rely on deep semantic structure.\n",
    "    → A keyword-sensitive model scores these LOW (incorrect).\n",
    "  Hard negatives : cross-group, same Service, TF-IDF > 0.35\n",
    "    → High lexical overlap but different routing groups (different meaning).\n",
    "    → A keyword-sensitive model scores these HIGH (incorrect).\n",
    "\n",
    "Verdict: ROC-AUC ≥ 0.70 → model discriminates groups, not keywords.\n",
    "         ROC-AUC < 0.70 → model is still using surface form ≈ semantics.\n",
    "\"\"\")\n",
    "\n",
    "diag_df = holdout_df.reset_index(drop=True)\n",
    "log(\"⏳ Building TF-IDF for adversarial pair mining...\")\n",
    "diag_tfidf = TFIDFSimilarityCalculator(\n",
    "    diag_df['Description'].fillna('').tolist(), max_features=10000\n",
    ")\n",
    "\n",
    "# Build lookup structures\n",
    "_diag_grp_idx = {g: list(ix) for g, ix in diag_df.groupby('Assignment group').groups.items()\n",
    "                 if len(ix) >= 2}\n",
    "_diag_svc_idx = {s: list(ix) for s, ix in diag_df.groupby('Service').groups.items()}\n",
    "_diag_all     = list(diag_df.index)\n",
    "\n",
    "hard_positives = []   # same group, low TF-IDF — no-keyword same-group signal\n",
    "hard_negatives = []   # cross-group, same service, high TF-IDF — keyword trap\n",
    "\n",
    "target_each  = 300\n",
    "_adv_rng     = np.random.RandomState(CONFIG['seed'] + 99)\n",
    "attempts     = 0\n",
    "max_attempts = 200_000\n",
    "\n",
    "log(\"⏳ Mining adversarial pairs...\")\n",
    "pbar = tqdm(total=target_each * 2, desc=\"Adversarial pairs\")\n",
    "\n",
    "while (len(hard_positives) < target_each or len(hard_negatives) < target_each) \\\n",
    "        and attempts < max_attempts:\n",
    "    attempts += 1\n",
    "\n",
    "    # ── Hard positive: same group, low TF-IDF (< 0.15) ──────────────────────\n",
    "    if len(hard_positives) < target_each and _diag_grp_idx:\n",
    "        _g     = _adv_rng.choice(list(_diag_grp_idx.keys()))\n",
    "        _ij    = _adv_rng.choice(_diag_grp_idx[_g], 2, replace=False)\n",
    "        _i, _j = int(_ij[0]), int(_ij[1])\n",
    "        _tf    = diag_tfidf.similarity(_i, _j)\n",
    "        if _tf < 0.15:\n",
    "            hard_positives.append(InputExample(\n",
    "                texts=[diag_df.at[_i, 'text'], diag_df.at[_j, 'text']],\n",
    "                label=1.0\n",
    "            ))\n",
    "            pbar.update(1)\n",
    "\n",
    "    # ── Hard negative: cross-group, same service, high TF-IDF (> 0.35) ───────\n",
    "    if len(hard_negatives) < target_each and _diag_all:\n",
    "        _i    = int(_adv_rng.choice(_diag_all))\n",
    "        _svc  = diag_df.at[_i, 'Service']\n",
    "        _grp1 = diag_df.at[_i, 'Assignment group']\n",
    "        _cands = [j for j in _diag_svc_idx.get(_svc, [])\n",
    "                  if diag_df.at[j, 'Assignment group'] != _grp1]\n",
    "        if _cands:\n",
    "            _j  = int(_adv_rng.choice(_cands))\n",
    "            _tf = diag_tfidf.similarity(_i, _j)\n",
    "            if _tf > 0.35:\n",
    "                hard_negatives.append(InputExample(\n",
    "                    texts=[diag_df.at[_i, 'text'], diag_df.at[_j, 'text']],\n",
    "                    label=0.0\n",
    "                ))\n",
    "                pbar.update(1)\n",
    "\n",
    "pbar.close()\n",
    "log(f\"[OK] Generated {len(hard_positives)} hard positives \"\n",
    "    f\"(same-group, TF<0.15)  |  {len(hard_negatives)} hard negatives \"\n",
    "    f\"(cross-group/same-svc, TF>0.35)\")\n",
    "\n",
    "# Evaluate\n",
    "adversarial_examples = hard_positives + hard_negatives\n",
    "if len(adversarial_examples) >= 100:\n",
    "    adv_results = comprehensive_eval(adversarial_examples, best_model, \"Adversarial\")\n",
    "    adversarial_results_dict = adv_results\n",
    "\n",
    "    log(\"\\n\" + \"=\"*60)\n",
    "    log(\"[TARGET] ADVERSARIAL DIAGNOSTIC RESULTS (V5.2 — Group Boundary)\")\n",
    "    log(\"=\"*60)\n",
    "    log(f\"Standard Eval ROC-AUC :   {eval_results['roc_auc']:.4f}\")\n",
    "    log(f\"Adversarial ROC-AUC   :   {adv_results['roc_auc']:.4f}\")\n",
    "    log(f\"Adversarial Spearman  :   {adv_results.get('spearman', float('nan')):.4f}\")\n",
    "    log(f\"Adversarial F1 @ best :   {adv_results['f1']:.4f}\")\n",
    "    log(f\"Hard pos mean score   :   \"\n",
    "        f\"{np.mean([best_model.encode([e.texts[0]])[0] @ best_model.encode([e.texts[1]])[0] for e in hard_positives[:20]]):.4f}\"\n",
    "        if hard_positives else \"[SKIP] too few hard positives\")\n",
    "    log(f\"Hard neg mean score   :   \"\n",
    "        f\"{np.mean([best_model.encode([e.texts[0]])[0] @ best_model.encode([e.texts[1]])[0] for e in hard_negatives[:20]]):.4f}\"\n",
    "        if hard_negatives else \"[SKIP] too few hard negatives\")\n",
    "\n",
    "    if adv_results['roc_auc'] >= 0.70 and adv_results['f1'] >= 0.65:\n",
    "        log(\"\\n[OK] VERDICT: Model discriminates Assignment groups beyond keywords!\")\n",
    "        log(\"   → High-TF cross-group pairs correctly scored LOW\")\n",
    "        log(\"   → Low-TF same-group pairs correctly scored HIGH\")\n",
    "        log(\"   → Model has learned group-level semantic structure\")\n",
    "        DIAGNOSTIC_PASSED = True\n",
    "    elif adv_results['roc_auc'] >= 0.55:\n",
    "        log(\"\\n[WARN] VERDICT: Partial group discrimination — marginal signal\")\n",
    "        log(\"   → Consider more epochs or stronger hard-neg ratio in Phase 3\")\n",
    "        DIAGNOSTIC_PASSED = False\n",
    "    else:\n",
    "        log(\"\\n[ERROR] VERDICT: Model relies on surface keywords, not group structure\")\n",
    "        log(\"   → Scores high: cross-group same-service pairs (keyword-similar)\")\n",
    "        log(\"   → Scores low:  same-group low-keyword pairs (should be HIGH)\")\n",
    "        log(\"   → Retrain with more hard negatives or joint Category label\")\n",
    "        DIAGNOSTIC_PASSED = False\n",
    "else:\n",
    "    log(f\"[WARN] Only {len(adversarial_examples)} adversarial pairs — need ≥ 100. \"\n",
    "        f\"Try larger holdout_df or relax TF-IDF thresholds.\")\n",
    "    DIAGNOSTIC_PASSED = None\n",
    "\n",
    "del diag_tfidf\n",
    "gc.collect()\n"
   ]
  },
