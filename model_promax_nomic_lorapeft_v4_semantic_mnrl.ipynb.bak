    "\n",
    "# ── Training curve plot ────────────────────────────────────────────────────\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "import matplotlib.ticker as mticker\n",
    "import pandas as pd\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "_save_dir = Path(str(save_path))\n",
    "\n",
    "# ── 1. Eval metrics ───────────────────────────────────────────────────────\n",
    "_eval_csv = _save_dir / 'eval_eval_results.csv'\n",
    "if _eval_csv.exists():\n",
    "    eval_hist = pd.read_csv(_eval_csv).apply(pd.to_numeric, errors='coerce').dropna()\n",
    "    print(f\"[OK] Eval history ({len(eval_hist)} rows) — raw epoch = phase number\")\n",
    "    print(eval_hist[['epoch','spearman','roc_auc','pr_auc']].to_string(index=False))\n",
    "else:\n",
    "    eval_hist = pd.DataFrame(columns=['epoch','steps','spearman','pearson','roc_auc','pr_auc'])\n",
    "    print(f\"[WARN] Eval CSV not found: {_eval_csv}\")\n",
    "\n",
    "# ── 2. Training loss (from known terminal output) ─────────────────────────\n",
    "# Phase 1: mid-epoch loss 0.1312, end-of-phase 0.0375\n",
    "# Phase 2: mid-epoch loss 0.0297, end-of-phase 0.0228\n",
    "# Phase 3: mid-epoch loss 0.0211, end-of-phase 0.0185\n",
    "# \"mid\" is logged around epoch 2 of each phase (step 626 / 1252 = 0.5 of 4 epochs)\n",
    "_epochs_per_phase = CONFIG.get('epochs_per_phase', 4)\n",
    "_phase_loss_data = [\n",
    "    (0.131225, 0.037504),  # phase 1: (mid, end)\n",
    "    (0.029699, 0.022795),  # phase 2\n",
    "    (0.021076, 0.018523),  # phase 3\n",
    "]\n",
    "_loss_manual = []\n",
    "for _ph_idx, (_mid_loss, _end_loss) in enumerate(_phase_loss_data):\n",
    "    _base = _ph_idx * _epochs_per_phase\n",
    "    _loss_manual.append({'epoch_continuous': _base + 2.0, 'loss': _mid_loss})\n",
    "    _loss_manual.append({'epoch_continuous': _base + 4.0, 'loss': _end_loss})\n",
    "loss_df = pd.DataFrame(_loss_manual)\n",
    "print(f\"[OK] Training loss: {len(loss_df)} data points (2 per phase from progress table)\")\n",
    "\n",
    "# ── 3. Setup ──────────────────────────────────────────────────────────────\n",
    "n_phases     = 3\n",
    "phase_colors = ['#4a90d9', '#e8882a', '#43b87e']\n",
    "phase_labels = ['Phase 1 (easy)', 'Phase 2 (medium)', 'Phase 3 (hard)']\n",
    "\n",
    "fig, (ax_eval, ax_loss) = plt.subplots(2, 1, figsize=(11, 8), sharex=True)\n",
    "fig.suptitle('Training Curves — V5.2  (LoRA MPNet · CosineSimilarityLoss · 12 epochs · 3-phase curriculum)',\n",
    "             fontsize=12, fontweight='bold', y=1.01)\n",
    "\n",
    "# Eval CSV uses epoch=1/2/3 → map to continuous epochs (end of each phase)\n",
    "if not eval_hist.empty:\n",
    "    eval_hist = eval_hist.copy()\n",
    "    eval_hist['epoch_x'] = eval_hist['epoch'].astype(float).apply(\n",
    "        lambda ph: ph * _epochs_per_phase  # 4, 8, 12\n",
    "    )\n",
    "\n",
    "# ── Eval metrics ──────────────────────────────────────────────────────────\n",
    "if not eval_hist.empty:\n",
    "    ax_eval.plot(eval_hist['epoch_x'], eval_hist['spearman'],\n",
    "                 'o-', color='steelblue', lw=2.2, ms=8,\n",
    "                 label='Spearman', zorder=4)\n",
    "    ax_eval.plot(eval_hist['epoch_x'], eval_hist['roc_auc'],\n",
    "                 's--', color='darkorange', lw=2, ms=7,\n",
    "                 label='ROC-AUC', zorder=4)\n",
    "    ax_eval.plot(eval_hist['epoch_x'], eval_hist['pr_auc'],\n",
    "                 '^:', color='seagreen', lw=1.8, ms=6,\n",
    "                 label='PR-AUC', zorder=4)\n",
    "\n",
    "    # Value labels above each Spearman point\n",
    "    for _, row in eval_hist.iterrows():\n",
    "        ax_eval.annotate(\n",
    "            f\"{row['spearman']:.4f}\",\n",
    "            xy=(row['epoch_x'], row['spearman']),\n",
    "            xytext=(0, 10), textcoords='offset points',\n",
    "            ha='center', fontsize=9, color='steelblue', fontweight='bold')\n",
    "\n",
    "    best_sp = float(eval_hist['spearman'].max())\n",
    "    ax_eval.axhline(best_sp, color='steelblue', lw=0.8, ls=':', alpha=0.45,\n",
    "                    label=f'Best Spearman = {best_sp:.4f}')\n",
    "    _y_min = max(0.0,  float(eval_hist[['spearman','roc_auc','pr_auc']].min().min()) - 0.025)\n",
    "    _y_max =           float(eval_hist[['spearman','roc_auc','pr_auc']].max().max()) + 0.06\n",
    "    ax_eval.set_ylim(_y_min, _y_max)\n",
    "\n",
    "ax_eval.set_ylabel('Score', fontsize=11)\n",
    "ax_eval.set_title('Evaluation Scores (per phase end)', fontsize=11)\n",
    "ax_eval.legend(fontsize=9, loc='lower right')\n",
    "ax_eval.grid(axis='y', alpha=0.3)\n",
    "ax_eval.yaxis.set_major_formatter(mticker.FormatStrFormatter('%.4f'))\n",
    "\n",
    "# ── Training loss ─────────────────────────────────────────────────────────\n",
    "ax_loss.plot(loss_df['epoch_continuous'], loss_df['loss'],\n",
    "             'o-', color='crimson', lw=2.2, ms=8, alpha=0.9,\n",
    "             label='Training loss')\n",
    "ax_loss.fill_between(loss_df['epoch_continuous'], loss_df['loss'],\n",
    "                     alpha=0.08, color='crimson')\n",
    "for _, row in loss_df.iterrows():\n",
    "    ax_loss.annotate(f\"{row['loss']:.4f}\",\n",
    "                     xy=(row['epoch_continuous'], row['loss']),\n",
    "                     xytext=(0, 10), textcoords='offset points',\n",
    "                     ha='center', fontsize=9, color='crimson', fontweight='bold')\n",
    "\n",
    "ax_loss.set_ylabel('CosineSimilarityLoss', fontsize=11)\n",
    "ax_loss.set_title('Training Loss  (mid-phase & end-of-phase values from progress table)', fontsize=11)\n",
    "ax_loss.legend(fontsize=9, loc='upper right')\n",
    "ax_loss.grid(axis='y', alpha=0.3)\n",
    "ax_loss.set_ylim(bottom=0)\n",
    "\n",
    "# ── Phase shading + vertical borders ─────────────────────────────────────\n",
    "for ax in (ax_eval, ax_loss):\n",
    "    _yl = ax.get_ylim()\n",
    "    for i in range(n_phases):\n",
    "        x0 = i * _epochs_per_phase\n",
    "        x1 = (i + 1) * _epochs_per_phase\n",
    "        ax.axvspan(x0, x1, alpha=0.07, color=phase_colors[i], zorder=0)\n",
    "        ax.axvline(x1, color=phase_colors[i], lw=1.4, ls='--', alpha=0.55, zorder=1)\n",
    "        # Phase label inside band, near top\n",
    "        ax.text((x0 + x1) / 2, _yl[1] - (_yl[1] - _yl[0]) * 0.03,\n",
    "                phase_labels[i], ha='center', va='top',\n",
    "                fontsize=8, color=phase_colors[i], fontweight='bold', alpha=0.9)\n",
    "\n",
    "# ── X-axis ────────────────────────────────────────────────────────────────\n",
    "_total_ep = _epochs_per_phase * n_phases\n",
    "ax_loss.set_xlabel('Epoch', fontsize=11)\n",
    "ax_loss.set_xlim(-0.3, _total_ep + 0.5)\n",
    "ax_loss.set_xticks(range(0, _total_ep + 1))\n",
    "\n",
    "# ── Phase legend ──────────────────────────────────────────────────────────\n",
    "_patches = [mpatches.Patch(color=phase_colors[i], alpha=0.4, label=phase_labels[i])\n",
    "            for i in range(n_phases)]\n",
    "fig.legend(handles=_patches, loc='upper right', fontsize=8, framealpha=0.75,\n",
    "           title='Curriculum phases', title_fontsize=8,\n",
    "           bbox_to_anchor=(1.0, 0.98))\n",
    "\n",
    "plt.tight_layout()\n",
    "_plot_out = _save_dir.parent / 'training_curves_v52.png'\n",
    "plt.savefig(_plot_out, dpi=130, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(f\"[SAVE] {_plot_out}\")\n"
   ]
