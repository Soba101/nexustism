   ],
   "source": [
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# CELL 12 — V5.2: Group-Based Pair Generation\n",
    "#\n",
    "# V5.2 changes vs V5.1:\n",
    "#   1. boilerplate_gate 0.50 → 0.30 (forces deeper semantic content in positives;\n",
    "#      old gate admitted near-boilerplate pairs that tokenise identically → easy\n",
    "#      trivial signal the model memorised without learning structure)\n",
    "#   2. Joint positive label: requires same Assignment group AND same Category.\n",
    "#      Same group / different Category is organisationally coincidental and adds\n",
    "#      label noise — skip those pairs rather than label them positive.\n",
    "#   3. Holdout + Borderline pairs generated from holdout_df for honest eval.\n",
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "import json\n",
    "import gc\n",
    "from pathlib import Path\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sentence_transformers import InputExample\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "# Helper: lightweight TF-IDF calculator\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "class _TFIDFCalc:\n",
    "    \"\"\"TF-IDF cosine similarity calculator (sparse, memory-efficient).\"\"\"\n",
    "\n",
    "    def __init__(self, texts, max_features=15000):\n",
    "        self._vec = TfidfVectorizer(\n",
    "            max_features=max_features, stop_words='english',\n",
    "            ngram_range=(1, 2), min_df=2, max_df=0.95\n",
    "        )\n",
    "        self._mat = self._vec.fit_transform(texts)\n",
    "\n",
    "    def sim(self, i: int, j: int) -> float:\n",
    "        return float((self._mat[i] @ self._mat[j].T).toarray()[0][0])\n",
    "\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "# Core: generate_group_based_pairs_v5\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "def generate_group_based_pairs_v5(\n",
    "    df, phase_name: str, target_count: int,\n",
    "    boilerplate_gate: float = 0.30,   # V5.2: tightened from 0.50\n",
    "    neg_gate: float = 0.25,\n",
    "    seed: int = 42,\n",
    "):\n",
    "    \"\"\"\n",
    "    Generate training pairs using Assignment group + Category as ground-truth label.\n",
    "\n",
    "    V5.2 positive criterion (both must hold):\n",
    "      • Same Assignment group (organisational routing)\n",
    "      • Same Category           (incident type — joint label reduces noise)\n",
    "      • TF-IDF ≤ boilerplate_gate (no near-duplicate boilerplate)\n",
    "\n",
    "    Curriculum phases vary hard-negative ratio:\n",
    "        phase1: 20% hard-neg | phase2: 35% | phase3: 40% (10% easy-neg floor)\n",
    "    \"\"\"\n",
    "    rng = np.random.RandomState(seed)\n",
    "    df  = df.reset_index(drop=True)\n",
    "\n",
    "    hard_neg_ratios = {'phase1': 0.20, 'phase2': 0.35, 'phase3': 0.40}\n",
    "    hard_neg_ratio  = hard_neg_ratios.get(phase_name, 0.35)\n",
    "    pos_target      = int(target_count * 0.50)\n",
    "    hard_neg_target = int(target_count * hard_neg_ratio)\n",
    "    easy_neg_target = target_count - pos_target - hard_neg_target\n",
    "\n",
    "    log(f\"\\n[BUILD] {phase_name}: target={target_count:,} \"\n",
    "        f\"| pos={pos_target:,}  hard-neg={hard_neg_target:,}  easy-neg={easy_neg_target:,}\")\n",
    "    log(f\"         boilerplate_gate={boilerplate_gate} (pos must have TF-IDF ≤ {boilerplate_gate})\")\n",
    "\n",
    "    has_category = 'Category' in df.columns\n",
    "    if has_category:\n",
    "        log(f\"         joint label: same group + same Category required\")\n",
    "\n",
    "    tfidf = _TFIDFCalc(df['Description'].fillna('').tolist())\n",
    "\n",
    "    group_idx   = {g: list(idxs)\n",
    "                   for g, idxs in df.groupby('Assignment group').groups.items()\n",
    "                   if len(idxs) >= 2}\n",
    "    service_idx = {s: list(idxs)\n",
    "                   for s, idxs in df.groupby('Service').groups.items()}\n",
    "    all_idx     = list(df.index)\n",
    "    pairs: list = []\n",
    "\n",
    "    # ── 1. POSITIVES: same group + same Category (V5.2) + TF-IDF gate ────────\n",
    "    pbar = tqdm(total=pos_target,\n",
    "                desc=f\"[{phase_name}] pos (same-group+cat, TF≤{boilerplate_gate})\")\n",
    "    attempts = 0\n",
    "    while len(pairs) < pos_target and attempts < pos_target * 100:\n",
    "        attempts += 1\n",
    "        g       = rng.choice(list(group_idx.keys()))\n",
    "        i1, i2  = rng.choice(group_idx[g], 2, replace=False)\n",
    "        i1, i2  = int(i1), int(i2)\n",
    "\n",
    "        # V5.2: joint label — skip same-group / different-Category pairs\n",
    "        if has_category:\n",
    "            c1 = str(df.at[i1, 'Category'])\n",
    "            c2 = str(df.at[i2, 'Category'])\n",
    "            # skip if either is NaN or they differ\n",
    "            if c1 == 'nan' or c2 == 'nan' or c1 != c2:\n",
    "                continue\n",
    "\n",
    "        if tfidf.sim(i1, i2) <= boilerplate_gate:\n",
    "            pairs.append(InputExample(\n",
    "                texts=[df.at[i1, 'text'], df.at[i2, 'text']], label=1.0\n",
    "            ))\n",
    "            pbar.update(1)\n",
    "    pbar.close()\n",
    "    actual_pos = len(pairs)\n",
    "\n",
    "    # ── 2. HARD-NEG: different group, same Service ────────────────────────────\n",
    "    current_len = len(pairs)\n",
    "    pbar = tqdm(total=hard_neg_target,\n",
    "                desc=f\"[{phase_name}] hard-neg (cross-group/same-svc, TF≤{neg_gate})\")\n",
    "    attempts = 0\n",
    "    while (len(pairs) - current_len) < hard_neg_target and attempts < hard_neg_target * 120:\n",
    "        attempts += 1\n",
    "        i1   = int(rng.choice(all_idx))\n",
    "        svc  = df.at[i1, 'Service']\n",
    "        grp1 = df.at[i1, 'Assignment group']\n",
    "        candidates = [j for j in service_idx.get(svc, [])\n",
    "                      if df.at[j, 'Assignment group'] != grp1]\n",
    "        if not candidates:\n",
    "            continue\n",
    "        i2 = int(rng.choice(candidates))\n",
    "        if tfidf.sim(i1, i2) <= neg_gate:\n",
    "            pairs.append(InputExample(\n",
    "                texts=[df.at[i1, 'text'], df.at[i2, 'text']], label=0.0\n",
    "            ))\n",
    "            pbar.update(1)\n",
    "    pbar.close()\n",
    "    actual_hard = len(pairs) - current_len\n",
    "\n",
    "    # ── 3. EASY-NEG: different Service entirely ───────────────────────────────\n",
    "    current_len = len(pairs)\n",
    "    pbar = tqdm(total=easy_neg_target,\n",
    "                desc=f\"[{phase_name}] easy-neg (cross-svc, TF≤{neg_gate})\")\n",
    "    attempts = 0\n",
    "    while (len(pairs) - current_len) < easy_neg_target and attempts < easy_neg_target * 60:\n",
    "        attempts += 1\n",
    "        i1, i2 = int(rng.choice(all_idx)), int(rng.choice(all_idx))\n",
    "        if i1 == i2 or df.at[i1, 'Service'] == df.at[i2, 'Service']:\n",
    "            continue\n",
    "        if tfidf.sim(i1, i2) <= neg_gate:\n",
    "            pairs.append(InputExample(\n",
    "                texts=[df.at[i1, 'text'], df.at[i2, 'text']], label=0.0\n",
    "            ))\n",
    "            pbar.update(1)\n",
    "    pbar.close()\n",
    "\n",
    "    del tfidf\n",
    "    gc.collect()\n",
    "\n",
    "    pos_n  = sum(1 for p in pairs if p.label == 1.0)\n",
    "    easy_n = len(pairs) - pos_n - actual_hard\n",
    "    log(f\"[OK] {phase_name}: {len(pairs):,} pairs \"\n",
    "        f\"| pos={pos_n:,} ({pos_n/max(1,len(pairs))*100:.1f}%) \"\n",
    "        f\"hard-neg={actual_hard:,}  easy-neg={easy_n:,}\")\n",
    "    return pairs\n",
    "\n",
    "\n",
    "def _pairs_to_dict(pairs):\n",
    "    return {\n",
    "        'texts1': [p.texts[0] for p in pairs],\n",
    "        'texts2': [p.texts[1] for p in pairs],\n",
    "        'labels': [float(p.label) for p in pairs],\n",
    "    }\n",
    "\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "# Load-or-generate group-based training pairs\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "def load_or_generate_group_pairs(config: dict, train_df):\n",
    "    pairs_path = Path(config['train_pairs_path'])\n",
    "\n",
    "    if pairs_path.exists():\n",
    "        log(f\"[LOAD] Loading group-based pairs → {pairs_path}\")\n",
    "        with open(pairs_path) as f:\n",
    "            raw = json.load(f)\n",
    "        phases: dict = {}\n",
    "        for key in ('phase1', 'phase2', 'phase3'):\n",
    "            if key in raw:\n",
    "                d = raw[key]\n",
    "                phases[key] = [\n",
    "                    InputExample(texts=[t1, t2], label=float(lb))\n",
    "                    for t1, t2, lb in zip(d['texts1'], d['texts2'], d['labels'])\n",
    "                ]\n",
    "                log(f\"   {key}: {len(phases[key]):,} pairs\")\n",
    "        return phases\n",
    "\n",
    "    log(f\"[GENERATE] Pairs not found — generating V5.2 pairs → {pairs_path}\")\n",
    "    log(f\"           boilerplate_gate=0.30, joint category label\")\n",
    "    pairs_per_phase = 5000\n",
    "    phases = {}\n",
    "    raw_save: dict = {}\n",
    "    for phase_name in ('phase1', 'phase2', 'phase3'):\n",
    "        ph = generate_group_based_pairs_v5(\n",
    "            train_df, phase_name, pairs_per_phase,\n",
    "            boilerplate_gate=0.30,   # V5.2: tightened gate\n",
    "            neg_gate=0.25, seed=config['seed']\n",
    "        )\n",
    "        phases[phase_name] = ph\n",
    "        raw_save[phase_name] = _pairs_to_dict(ph)\n",
    "\n",
    "    pairs_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    with open(pairs_path, 'w') as f:\n",
    "        json.dump(raw_save, f)\n",
    "    log(f\"[OK] Saved → {pairs_path}\")\n",
    "    return phases\n",
    "\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "# 1. Training pairs\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "CURRICULUM_PHASES = load_or_generate_group_pairs(CONFIG, train_df)\n",
    "\n",
    "train_examples: list = []\n",
    "for _key in ('phase1', 'phase2', 'phase3'):\n",
    "    train_examples.extend(CURRICULUM_PHASES.get(_key, []))\n",
    "\n",
    "_pos = sum(1 for p in train_examples if p.label == 1.0)\n",
    "log(f\"\\n[STATS] Training pairs (all phases): {len(train_examples):,} \"\n",
    "    f\"| pos={_pos:,}  neg={len(train_examples)-_pos:,}\")\n",
    "\n",
    "# ── MNRL Positive-Only Pairs ────────────────────────────────────────────────\n",
    "# MNRL needs only anchor-positive pairs; all other batch items become negatives.\n",
    "# We extract positives from existing CURRICULUM_PHASES — no extra generation.\n",
    "if CONFIG.get('use_mnrl_positive_only', False):\n",
    "    _mnrl_path = Path(CONFIG.get('train_pairs_path_mnrl',\n",
    "                                 'data_new/group_based_positive_only_pairs_mnrl_v1.json'))\n",
    "    mnrl_positive_examples = [p for p in train_examples if p.label == 1.0]\n",
    "    log(f'[MNRL] Positive-only pairs extracted: {len(mnrl_positive_examples):,}')\n",
    "    if not _mnrl_path.exists():\n",
    "        _mnrl_save = {\n",
    "            'texts1': [p.texts[0] for p in mnrl_positive_examples],\n",
    "            'texts2': [p.texts[1] for p in mnrl_positive_examples],\n",
    "        }\n",
    "        _mnrl_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "        _mnrl_path.write_text(json.dumps(_mnrl_save, ensure_ascii=False), encoding='utf-8')\n",
    "        log(f'[SAVE] MNRL pairs saved: {len(mnrl_positive_examples):,} → {_mnrl_path}')\n",
    "else:\n",
    "    mnrl_positive_examples = None\n",
    "    log('[INFO] MNRL mode OFF — CosineSimilarityLoss with pos+neg pairs (default)')\n",
    "\n",
    "\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "# 2. Evaluation pairs — semantic_test_pairs_v3 (group-based, NOT MPNet-cosine)\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "_eval_path = Path(CONFIG.get('eval_pairs_path', 'data_new/semantic_test_pairs_v3.json'))\n",
    "log(f\"\\n[LOAD] Eval pairs (group-based): {_eval_path}\")\n",
    "\n",
    "with open(_eval_path) as f:\n",
    "    _v3_raw = json.load(f)\n",
    "\n",
    "if isinstance(_v3_raw, list):\n",
    "    eval_examples = [\n",
    "        InputExample(texts=[p['text1'], p['text2']], label=float(p['label']))\n",
    "        for p in _v3_raw\n",
    "    ]\n",
    "else:\n",
    "    eval_examples = [\n",
    "        InputExample(texts=[t1, t2], label=float(lb))\n",
    "        for t1, t2, lb in zip(_v3_raw['texts1'], _v3_raw['texts2'], _v3_raw['labels'])\n",
    "    ]\n",
    "\n",
    "_eval_pos = sum(1 for e in eval_examples if e.label == 1.0)\n",
    "log(f\"[OK] Eval pairs: {len(eval_examples):,} \"\n",
    "    f\"| pos={_eval_pos:,} ({_eval_pos/len(eval_examples)*100:.1f}%) \"\n",
    "    f\"neg={len(eval_examples)-_eval_pos:,}\")\n",
    "\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "# 3. Holdout pairs — completely unseen data (holdout_df from Cell 4)\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "log(\"\\n[BUILD] Generating holdout pairs (unseen holdout_df split)...\")\n",
    "holdout_examples = generate_group_based_pairs_v5(\n",
    "    holdout_df, phase_name='phase2',   # medium difficulty — balanced for eval\n",
    "    target_count=500,\n",
    "    boilerplate_gate=0.30, neg_gate=0.25, seed=CONFIG['seed'] + 1\n",
    ")\n",
    "log(f\"[OK] Holdout: {len(holdout_examples):,} pairs \"\n",
    "    f\"| pos={sum(1 for e in holdout_examples if e.label==1.0):,} \"\n",
    "    f\"neg={sum(1 for e in holdout_examples if e.label==0.0):,}\")\n",
    "\n",
    "\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "# 4. Borderline pairs — ambiguous zone: same-group (TF-IDF 0.05–0.30) +\n",
    "#    cross-group same-service (TF-IDF 0.20–0.40)\n",
    "# ────────────────────────────────────────────────────────────────────────────\n",
    "log(\"\\n[BUILD] Generating borderline pairs (ambiguous TF-IDF zone)...\")\n",
    "_tfidf_bl = _TFIDFCalc(holdout_df['Description'].fillna('').tolist())\n",
    "_rng_bl   = np.random.RandomState(CONFIG['seed'] + 2)\n",
    "_hdf      = holdout_df.reset_index(drop=True)\n",
    "_grp_idx  = {g: list(ix) for g, ix in _hdf.groupby('Assignment group').groups.items() if len(ix) >= 2}\n",
    "_svc_idx  = {s: list(ix) for s, ix in _hdf.groupby('Service').groups.items()}\n",
    "\n",
    "borderline_examples = []\n",
    "_attempts = 0\n",
    "\n",
    "# Ambiguous positives: same group, TF-IDF in [0.05, 0.30] — non-trivial same-group\n",
    "while len(borderline_examples) < 250 and _attempts < 40000:\n",
    "    _attempts += 1\n",
    "    if not _grp_idx:\n",
    "        break\n",
    "    _g      = _rng_bl.choice(list(_grp_idx.keys()))\n",
    "    _ij     = _rng_bl.choice(_grp_idx[_g], 2, replace=False)\n",
    "    _i, _j  = int(_ij[0]), int(_ij[1])\n",
    "    _tf     = _tfidf_bl.sim(_i, _j)\n",
    "    if 0.05 <= _tf <= 0.30:\n",
    "        borderline_examples.append(InputExample(\n",
    "            texts=[_hdf.at[_i, 'text'], _hdf.at[_j, 'text']], label=1.0\n",
    "        ))\n",
    "\n",
    "# Ambiguous negatives: cross-group same-service, TF-IDF in [0.20, 0.40] — hard to separate\n",
    "while len(borderline_examples) < 500 and _attempts < 80000:\n",
    "    _attempts += 1\n",
    "    _i   = int(_rng_bl.choice(list(_hdf.index)))\n",
    "    _svc = _hdf.at[_i, 'Service']\n",
    "    _cands = [j for j in _svc_idx.get(_svc, [])\n",
    "              if _hdf.at[j, 'Assignment group'] != _hdf.at[_i, 'Assignment group']]\n",
    "    if not _cands:\n",
    "        continue\n",
    "    _j  = int(_rng_bl.choice(_cands))\n",
    "    _tf = _tfidf_bl.sim(_i, _j)\n",
    "    if 0.20 <= _tf <= 0.40:\n",
    "        borderline_examples.append(InputExample(\n",
    "            texts=[_hdf.at[_i, 'text'], _hdf.at[_j, 'text']], label=0.0\n",
    "        ))\n",
    "\n",
    "del _tfidf_bl\n",
    "gc.collect()\n",
    "log(f\"[OK] Borderline: {len(borderline_examples):,} pairs \"\n",
    "    f\"| pos={sum(1 for e in borderline_examples if e.label==1.0):,} \"\n",
    "    f\"neg={sum(1 for e in borderline_examples if e.label==0.0):,}\")\n",
    "\n",
    "# Stubs for legacy code that expects these variables\n",
    "tfidf_train = None\n",
    "tfidf_eval  = None\n",
    "tfidf_holdout = None\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "eadfadea",
   "metadata": {
    "description": "Markdown: Pair Generation"
   },
   "source": [
    "# 5. Pair Generation\n",
    "\n",
    "Generate training pairs using TF-IDF similarity mining:\n",
    "- **35% Positives**: High TF-IDF similarity (> 0.35)\n",
    "- **35% Hard Negatives**: Same category, low TF-IDF (< 0.20)\n",
    "- **30% Easy Negatives**: Different category, low TF-IDF\n",
    "\n",
    "This forces the model to learn semantic content, not just category matching."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "9ff4c6d1",
   "metadata": {
    "description": "Pair Generation: TF-IDF classes (legacy, SKIPPED)"
   },
   "outputs": [],
   "source": [
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sentence_transformers import InputExample\n",
    "from tqdm.auto import tqdm\n",
    "import gc\n",
    "\n",
    "class TFIDFSimilarityCalculator:\n",
    "    \"\"\"Efficient TF-IDF similarity calculator for large datasets.\"\"\"\n",
    "    \n",
    "    def __init__(self, texts, max_features=15000):\n",
    "        log(\"⏳ Building TF-IDF matrix...\")\n",
    "        self.vectorizer = TfidfVectorizer(\n",
    "            max_features=max_features,\n",
    "            stop_words='english',\n",
    "            ngram_range=(1, 2),  # Unigrams + bigrams for better matching\n",
    "            min_df=2,           # Ignore very rare terms\n",
    "            max_df=0.95         # Ignore very common terms\n",
    "        )\n",
    "        self.tfidf_matrix = self.vectorizer.fit_transform(texts)\n",
    "        log(f\"[OK] TF-IDF matrix: {self.tfidf_matrix.shape} (vocab size: {len(self.vectorizer.vocabulary_)})\")\n",
    "    \n",
    "    def similarity(self, idx1, idx2):\n",
    "        \"\"\"Compute cosine similarity between two documents.\"\"\"\n",
    "        if idx1 >= self.tfidf_matrix.shape[0] or idx2 >= self.tfidf_matrix.shape[0]:\n",
    "            return 0.0\n",
    "        vec1 = self.tfidf_matrix[idx1]\n",
    "        vec2 = self.tfidf_matrix[idx2]\n",
    "        return (vec1 @ vec2.T).toarray()[0][0]\n",
    "\n",
    "\n",
    "def generate_training_pairs(df, target_count, config, desc=\"\", phase_config=None, tfidf_calc=None):\n",
    "    \"\"\"\n",
    "    Generate training pairs with configurable split (V2: supports curriculum phases).\n",
    "    \n",
    "    Args:\n",
    "        df: DataFrame with ticket data\n",
    "        target_count: Total number of pairs to generate\n",
    "        config: Main configuration dict\n",
    "        desc: Description for logging\n",
    "        phase_config: Optional override for curriculum learning phase\n",
    "        tfidf_calc: Optional precomputed TF-IDF calculator to avoid rebuilding\n",
    "    \"\"\"\n",
    "    df = df.reset_index(drop=True)\n",
    "    \n",
    "    if config.get('use_pre_generated_pairs', False) and phase_config and phase_config.get('phase_key') and CURRICULUM_PHASES:\n",
    "        phase_key = phase_config['phase_key']\n",
    "        phase_pairs = CURRICULUM_PHASES.get(phase_key, [])\n",
    "        log(f\"\\n[SKIP] Using pre-generated pairs for {phase_key}: {len(phase_pairs):,}\")\n",
    "        return phase_pairs\n",
    "    \n",
    "    # Use phase config if provided (for curriculum learning)\n",
    "    pos_ratio = config['pos_ratio']\n",
    "    hard_neg_ratio = phase_config['hard_neg_ratio'] if phase_config else config['hard_neg_ratio']\n",
    "    neg_threshold = phase_config['neg_threshold'] if phase_config else config['neg_tfidf_threshold']\n",
    "    easy_neg_ratio = 1.0 - pos_ratio - hard_neg_ratio\n",
    "    \n",
    "    # Build or reuse TF-IDF for this split\n",
    "    created_tfidf = False\n",
    "    if tfidf_calc is None:\n",
    "        tfidf_calc = TFIDFSimilarityCalculator(df['text'].tolist())\n",
    "        created_tfidf = True\n",
    "    \n",
    "    # Calculate targets\n",
    "    pos_target = int(target_count * pos_ratio)\n",
    "    hard_neg_target = int(target_count * hard_neg_ratio)\n",
    "    easy_neg_target = target_count - pos_target - hard_neg_target\n",
    "    \n",
    "    pairs = []\n",
    "    all_indices = list(df.index)\n",
    "    \n",
    "    # Group by category for hard negatives\n",
    "    category_groups = df.groupby('category_id').indices\n",
    "    valid_groups = {k: list(v) for k, v in category_groups.items() if len(v) >= 2}\n",
    "    \n",
    "    log(f\"\\n[TARGET] Generating {target_count:,} pairs for {desc}:\")\n",
    "    log(f\"   Target: {pos_target:,} positives ({pos_ratio*100:.0f}%), {hard_neg_target:,} hard neg ({hard_neg_ratio*100:.0f}%), {easy_neg_target:,} easy neg\")\n",
    "    log(f\"   Neg TF-IDF threshold: {neg_threshold}\")\n",
    "    \n",
    "    # ============================================\n",
    "    # 1. POSITIVES: High TF-IDF similarity (> threshold)\n",
    "    # ============================================\n",
    "    pbar = tqdm(total=pos_target, desc=\"Positives (high TF-IDF)\")\n",
    "    attempts, max_attempts = 0, pos_target * 50\n",
    "    \n",
    "    while len(pairs) < pos_target and attempts < max_attempts:\n",
    "        attempts += 1\n",
    "        i1, i2 = random.sample(all_indices, 2)\n",
    "        if i1 == i2:\n",
    "            continue\n",
    "        \n",
    "        sim = tfidf_calc.similarity(i1, i2)\n",
    "        if sim > config['pos_tfidf_threshold']:\n",
    "            pairs.append(InputExample(\n",
    "                texts=[df.at[i1, 'text'], df.at[i2, 'text']],\n",
    "                label=1.0\n",
    "            ))\n",
    "            pbar.update(1)\n",
    "    pbar.close()\n",
    "    actual_pos = len(pairs)\n",
    "    \n",
    "    # ============================================\n",
    "    # 2. HARD NEGATIVES: Same category, low TF-IDF (V2: stricter threshold)\n",
    "    # ============================================\n",
    "    current_len = len(pairs)\n",
    "    pbar = tqdm(total=hard_neg_target, desc=f\"Hard Negatives (same cat, TF-IDF<{neg_threshold})\")\n",
    "    attempts, max_attempts = 0, hard_neg_target * 50\n",
    "    \n",
    "    while (len(pairs) - current_len) < hard_neg_target and attempts < max_attempts:\n",
    "        attempts += 1\n",
    "        if not valid_groups:\n",
    "            break\n",
    "        \n",
    "        # Pick a random category with 2+ members\n",
    "        gid = random.choice(list(valid_groups.keys()))\n",
    "        g_indices = valid_groups[gid]\n",
    "        if len(g_indices) < 2:\n",
    "            continue\n",
    "        \n",
    "        i1, i2 = random.sample(g_indices, 2)\n",
    "        sim = tfidf_calc.similarity(i1, i2)\n",
    "        \n",
    "        if sim < neg_threshold:  # V2: Uses stricter threshold\n",
    "            pairs.append(InputExample(\n",
    "                texts=[df.at[i1, 'text'], df.at[i2, 'text']],\n",
    "                label=0.0\n",
    "            ))\n",
    "            pbar.update(1)\n",
    "    pbar.close()\n",
    "    actual_hard = len(pairs) - current_len\n",
    "    \n",
    "    # ============================================\n",
    "    # 3. EASY NEGATIVES: Cross-category, low TF-IDF\n",
    "    # ============================================\n",
    "    current_len = len(pairs)\n",
    "    pbar = tqdm(total=easy_neg_target, desc=\"Easy Negatives (cross-cat)\")\n",
    "    attempts, max_attempts = 0, easy_neg_target * 50\n",
    "    \n",
    "    while (len(pairs) - current_len) < easy_neg_target and attempts < max_attempts:\n",
    "        attempts += 1\n",
    "        i1, i2 = random.sample(all_indices, 2)\n",
    "        \n",
    "        # Must be different categories\n",
    "        if df.at[i1, 'category_id'] == df.at[i2, 'category_id']:\n",
    "            continue\n",
    "        \n",
    "        sim = tfidf_calc.similarity(i1, i2)\n",
    "        if sim < neg_threshold:\n",
    "            pairs.append(InputExample(\n",
    "                texts=[df.at[i1, 'text'], df.at[i2, 'text']],\n",
    "                label=0.0\n",
    "            ))\n",
    "            pbar.update(1)\n",
    "    pbar.close()\n",
    "    actual_easy = len(pairs) - current_len\n",
    "    \n",
    "    # Summary\n",
    "    total_pos = sum(1 for p in pairs if p.label == 1.0)\n",
    "    total_neg = len(pairs) - total_pos\n",
    "    \n",
    "    log(f\"[OK] Generated {len(pairs):,} pairs:\")\n",
    "    log(f\"   Positives: {actual_pos:,} ({actual_pos/len(pairs)*100:.1f}%)\")\n",
    "    log(f\"   Hard Neg:  {actual_hard:,} ({actual_hard/len(pairs)*100:.1f}%)\")\n",
    "    log(f\"   Easy Neg:  {actual_easy:,} ({actual_easy/len(pairs)*100:.1f}%)\")\n",
    "    \n",
    "    # Clean up TF-IDF to free memory only if we created it here\n",
    "    if created_tfidf:\n",
    "        del tfidf_calc\n",
    "        gc.collect()\n",
    "    \n",
    "    return pairs\n",
    "\n",
    "\n",
    "def generate_borderline_pairs(df, target_count, config, desc=\"Borderline\", tfidf_calc=None):\n",
    "    \"\"\"\n",
    "    V2 NEW: Generate borderline/ambiguous pairs for harder evaluation.\n",
    "    \n",
    "    These are pairs with TF-IDF similarity in the 0.25-0.35 range - \n",
    "    cases where it's genuinely hard to determine similarity.\n",
    "    \"\"\"\n",
    "    df = df.reset_index(drop=True)\n",
    "    created_tfidf = False\n",
    "    if tfidf_calc is None:\n",
    "        tfidf_calc = TFIDFSimilarityCalculator(df['text'].tolist())\n",
    "        created_tfidf = True\n",
    "    \n",
    "    borderline_pairs = []\n",
    "    all_indices = list(df.index)\n",
    "    \n",
    "    # TF-IDF range for borderline cases\n",
    "    low_threshold = 0.25\n",
    "    high_threshold = 0.35\n",
    "    \n",
    "    log(f\"\\n[TARGET] Generating {target_count:,} borderline pairs ({desc}):\")\n",
    "    log(f\"   TF-IDF range: {low_threshold} - {high_threshold}\")\n",
    "    \n",
    "    pbar = tqdm(total=target_count, desc=\"Borderline pairs\")\n",
    "    attempts, max_attempts = 0, target_count * 100\n",
    "    \n",
    "    while len(borderline_pairs) < target_count and attempts < max_attempts:\n",
    "        attempts += 1\n",
    "        i1, i2 = random.sample(all_indices, 2)\n",
    "        if i1 == i2:\n",
    "            continue\n",
    "        \n",
    "        sim = tfidf_calc.similarity(i1, i2)\n",
    "        \n",
    "        # Borderline: medium TF-IDF similarity (ambiguous)\n",
    "        if low_threshold <= sim <= high_threshold:\n",
    "            # Label based on same category (proxy for similarity)\n",
    "            same_cat = df.at[i1, 'category_id'] == df.at[i2, 'category_id']\n",
    "            label = 1.0 if same_cat else 0.0\n",
    "            \n",
    "            borderline_pairs.append(InputExample(\n",
    "                texts=[df.at[i1, 'text'], df.at[i2, 'text']],\n",
    "                label=label\n",
    "            ))\n",
    "            pbar.update(1)\n",
    "    \n",
    "    pbar.close()\n",
    "    \n",
    "    pos_count = sum(1 for p in borderline_pairs if p.label == 1.0)\n",
    "    log(f\"[OK] Generated {len(borderline_pairs):,} borderline pairs:\")\n",
    "    log(f\"   Positives: {pos_count:,} ({pos_count/len(borderline_pairs)*100:.1f}%)\")\n",
    "    log(f\"   Negatives: {len(borderline_pairs)-pos_count:,}\")\n",
    "    \n",
    "    if created_tfidf:\n",
    "        del tfidf_calc\n",
    "        gc.collect()\n",
    "    \n",
    "    return borderline_pairs"
   ]
  },
