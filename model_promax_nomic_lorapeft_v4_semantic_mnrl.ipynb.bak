   ],
   "source": [
    "# V5: Visualization — handles None for holdout / borderline (not generated in curriculum path)\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Ensure eval_results is available (re-run if cell order was skipped)\n",
    "if 'eval_results' not in globals():\n",
    "    if 'best_model' not in globals():\n",
    "        raise RuntimeError(\"best_model not defined. Run the training/evaluation cells first.\")\n",
    "    log(\"[WARN] eval_results missing — running evaluation now...\")\n",
    "    if 'cv_threshold' not in globals():\n",
    "        cv_threshold, cv_std = get_cv_threshold(\n",
    "            eval_examples, best_model, n_folds=CONFIG.get('threshold_cv_folds', 5)\n",
    "        )\n",
    "    eval_results     = comprehensive_eval(eval_examples, best_model, \"Eval Set\")\n",
    "    holdout_results  = None\n",
    "    borderline_results = None\n",
    "\n",
    "# Resolve holdout / borderline to None if not computed\n",
    "holdout_results    = globals().get('holdout_results')\n",
    "borderline_results = globals().get('borderline_results')\n",
    "\n",
    "\n",
    "def _plot_roc(ax, results, label_prefix, color='steelblue'):\n",
    "    if results is not None:\n",
    "        ax.plot(results['fpr'], results['tpr'],\n",
    "                label=f\"{label_prefix} ROC-AUC = {results['roc_auc']:.3f}\", color=color)\n",
    "        ax.plot([0, 1], [0, 1], 'k--', alpha=0.5)\n",
    "        ax.legend()\n",
    "    else:\n",
    "        ax.text(0.5, 0.5, f'{label_prefix}\\nNot Available',\n",
    "                ha='center', va='center', transform=ax.transAxes)\n",
    "    ax.set_title(f'ROC Curve ({label_prefix})')\n",
    "    ax.set_xlabel('False Positive Rate')\n",
    "    ax.set_ylabel('True Positive Rate')\n",
    "\n",
    "\n",
    "def _plot_pr(ax, results, label_prefix, color='steelblue'):\n",
    "    if results is not None:\n",
    "        ax.plot(results['recall'], results['precision'],\n",
    "                label=f\"{label_prefix} PR-AUC = {results['pr_auc']:.3f}\", color=color)\n",
    "        ax.scatter([results['rec']], [results['prec']], color='red', s=100, zorder=5,\n",
    "                   label=f\"Best F1={results['f1']:.3f}\")\n",
    "        ax.legend()\n",
    "    else:\n",
    "        ax.text(0.5, 0.5, f'{label_prefix}\\nNot Available',\n",
    "                ha='center', va='center', transform=ax.transAxes)\n",
    "    ax.set_title(f'Precision-Recall ({label_prefix})')\n",
    "    ax.set_xlabel('Recall')\n",
    "    ax.set_ylabel('Precision')\n",
    "\n",
    "\n",
    "def _plot_dist(ax, results, label_prefix):\n",
    "    if results is not None:\n",
    "        neg_s = results['scores'][results['labels'] == 0]\n",
    "        pos_s = results['scores'][results['labels'] == 1]\n",
    "        ax.hist(neg_s, bins=30, alpha=0.6, label='Negative (0)', color='blue')\n",
    "        ax.hist(pos_s, bins=30, alpha=0.6, label='Positive (1)', color='orange')\n",
    "        ax.axvline(results['best_threshold'], color='red', linestyle='--',\n",
    "                   label=f\"Threshold={results['best_threshold']:.3f}\")\n",
    "        if 'cv_threshold' in globals():\n",
    "            ax.axvline(cv_threshold, color='green', linestyle=':',\n",
    "                       label=f\"CV={cv_threshold:.3f}\")\n",
    "        ax.legend(fontsize=8)\n",
    "    else:\n",
    "        ax.text(0.5, 0.5, f'{label_prefix}\\nNot Available',\n",
    "                ha='center', va='center', transform=ax.transAxes)\n",
    "    ax.set_title(f'Score Distribution ({label_prefix})')\n",
    "    ax.set_xlabel('Cosine Similarity')\n",
    "    ax.set_ylabel('Count')\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(3, 3, figsize=(16, 14))\n",
    "\n",
    "_plot_roc(axes[0, 0], eval_results,     'Eval (v3 group)', color='steelblue')\n",
    "_plot_roc(axes[0, 1], holdout_results,  'Holdout',         color='orange')\n",
    "_plot_roc(axes[0, 2], borderline_results, 'Borderline',    color='red')\n",
    "\n",
    "_plot_pr(axes[1, 0], eval_results,     'Eval (v3 group)', color='steelblue')\n",
    "_plot_pr(axes[1, 1], holdout_results,  'Holdout',         color='orange')\n",
    "_plot_pr(axes[1, 2], borderline_results, 'Borderline',    color='red')\n",
    "\n",
    "_plot_dist(axes[2, 0], eval_results,     'Eval (v3 group)')\n",
    "_plot_dist(axes[2, 1], holdout_results,  'Holdout')\n",
    "_plot_dist(axes[2, 2], borderline_results, 'Borderline')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(save_path / 'evaluation_plots_v5.png', dpi=150)\n",
    "plt.show()\n",
    "log(f\"\\n[OK] Plots saved → {save_path / 'evaluation_plots_v5.png'}\")\n"
   ]
  },
